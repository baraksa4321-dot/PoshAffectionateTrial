# The API server uses this key only for the server-side Open Food Facts importer.
# Never expose the service-role key to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
PROTEIN_CATALOG_SYNC_ENABLED=true
# Optional; defaults to once per day.
PROTEIN_CATALOG_SYNC_INTERVAL_MS=86400000