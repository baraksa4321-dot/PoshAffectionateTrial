te(-18deg);\n}\n\n.loading-apple-shine {\n  z-index: 2;\n  background: #ffffffa6;\n  border-radius: 50%;\n  width: 10px;\n  height: 17px;\n  position: absolute;\n  bottom: 37px;\n  right: 31px;\n  transform: rotate(28deg);\n}\n\n.loading-bowl-wrap {\n  width: 112px;\n  height: 88px;\n  margin: 0 auto;\n  position: relative;\n}\n\n.loading-bowl {\n  border: 3px solid var(--primary);\n  background: var(--secondary);\n  border-radius: 8px 8px 34px 34px;\n  width: 76px;\n  height: 44px;\n  position: absolute;\n  bottom: 8px;\n  right: 18px;\n  overflow: hidden;\n}\n\n.loading-bowl:before {\n  border: 3px solid var(--primary);\n  background: var(--cream);\n  content: \"\";\n  border-radius: 50%;\n  width: 76px;\n  height: 18px;\n  position: absolute;\n  top: -8px;\n  left: -3px;\n}\n\n.loading-bowl-fill {\n  background: var(--sage);\n  height: 35%;\n  animation: 1.7s ease-in-out infinite loading-bowl-fill;\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n}\n\n.loading-spoon {\n  background: var(--ink);\n  transform-origin: bottom;\n  border-radius: 999px;\n  width: 6px;\n  height: 75px;\n  animation: 1.7s ease-in-out infinite loading-stir;\n  position: absolute;\n  top: 7px;\n  left: 18px;\n  transform: rotate(27deg);\n}\n\n.loading-spoon:before {\n  background: var(--ink);\n  content: \"\";\n  border-radius: 50%;\n  width: 16px;\n  height: 20px;\n  position: absolute;\n  top: -5px;\n  left: -5px;\n}\n\n.loading-food {\n  z-index: 2;\n  background: var(--rose);\n  border-radius: 50%;\n  width: 9px;\n  height: 9px;\n  animation: 1.7s ease-in-out infinite loading-food-pop;\n  position: absolute;\n}\n\n.loading-food-one {\n  top: 25px;\n  right: 43px;\n}\n\n.loading-food-two {\n  background: var(--primary);\n  width: 7px;\n  height: 7px;\n  animation-delay: .25s;\n  top: 37px;\n  right: 58px;\n}\n\n.loading-food-three {\n  background: var(--sage);\n  width: 6px;\n  height: 6px;\n  animation-delay: .5s;\n  top: 35px;\n  right: 30px;\n}\n\n@keyframes loading-lift {\n  0%, 100% {\n    transform: translateY(5px) rotate(-3deg);\n  }\n\n  50% {\n    transform: translateY(-7px) rotate(3deg);\n  }\n}\n\n@keyframes loading-bounce {\n  0%, 100% {\n    transform: translateY(4px) rotate(-4deg);\n  }\n\n  50% {\n    transform: translateY(-7px) rotate(4deg);\n  }\n}\n\n@keyframes loading-bowl-fill {\n  0%, 100% {\n    height: 30%;\n  }\n\n  50% {\n    height: 70%;\n  }\n}\n\n@keyframes loading-stir {\n  0%, 100% {\n    transform: rotate(20deg);\n  }\n\n  50% {\n    transform: rotate(42deg);\n  }\n}\n\n@keyframes loading-food-pop {\n  0%, 100% {\n    opacity: .45;\n    transform: translateY(10px) scale(.8);\n  }\n\n  50% {\n    opacity: 1;\n    transform: translateY(-3px) scale(1);\n  }\n}\n\n.loading-cup {\n  border: 3px solid var(--primary);\n  background: var(--primary);\n  border-radius: 8px 8px 18px 18px;\n  width: 56px;\n  height: 55px;\n  position: absolute;\n  bottom: 7px;\n  right: 18px;\n  overflow: hidden;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-cup {\n    background: color-mix(in srgb, var(--primary) 7%, white);\n  }\n}\n\n.loading-cup {\n  transform: rotate(-4deg);\n}\n\n.loading-cup:before {\n  border: 3px solid var(--primary);\n  content: \"\";\n  background: #fff;\n  border-radius: 50%;\n  width: 60px;\n  height: 12px;\n  position: absolute;\n  top: -5px;\n  left: -5px;\n}\n\n.loading-cup-fill {\n  background: linear-gradient(180deg, var(--rose), var(--primary));\n  height: 16%;\n  animation: 1.8s ease-in-out infinite loading-fill;\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n}\n\n.loading-cup-handle {\n  border: 3px solid var(--primary);\n  border-left: 0;\n  border-radius: 0 14px 14px 0;\n  width: 22px;\n  height: 27px;\n  position: absolute;\n  bottom: 20px;\n  right: 4px;\n  transform: rotate(-4deg);\n}\n\n.loading-bubble {\n  background: var(--primary);\n  opacity: 0;\n  border-radius: 999px;\n  width: 7px;\n  height: 7px;\n  animation: 1.8s ease-in infinite loading-bubble;\n  position: absolute;\n  bottom: 48px;\n}\n\n.loading-bubble-one {\n  right: 42px;\n}\n\n.loading-bubble-two {\n  width: 5px;\n  height: 5px;\n  animation-delay: .55s;\n  right: 29px;\n}\n\n.loading-bubble-three {\n  width: 4px;\n  height: 4px;\n  animation-delay: 1s;\n  right: 52px;\n}\n\n@keyframes loading-fill {\n  0%, 100% {\n    height: 16%;\n  }\n\n  50% {\n    height: 72%;\n  }\n}\n\n@keyframes loading-bubble {\n  0% {\n    opacity: 0;\n    transform: translateY(10px) scale(.7);\n  }\n\n  35%, 70% {\n    opacity: .7;\n  }\n\n  100% {\n    opacity: 0;\n    transform: translateY(-24px) scale(1);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage, .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage *, .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage:before, .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage:after {\n    animation-duration: 1.8s !important;\n    animation-iteration-count: infinite !important;\n  }\n}\n\n.loading-screen {\n  z-index: 1000;\n  box-sizing: border-box;\n  overscroll-behavior: none;\n  touch-action: none;\n  width: 100%;\n  height: 100lvh;\n  min-height: 100lvh;\n  max-height: 100lvh;\n  padding-top: env(safe-area-inset-top);\n  padding-bottom: env(safe-area-inset-bottom);\n  color: #171414;\n  position: fixed;\n  inset: 0;\n  overflow: hidden;\n  background: #f7f1ec !important;\n}\n\n.loading-screen:before, .loading-screen:after, .loading-stage, .loading-orbit, .loading-spark {\n  display: none;\n}\n\n.loading-brand {\n  text-align: center;\n  background: none;\n  width: min(100%, 240px);\n  padding: 14px 0 10px;\n}\n\n.loading-wordmark, .loading-initial-wordmark {\n  z-index: 2;\n  object-fit: contain;\n  height: auto;\n  margin: 0;\n  display: block;\n  position: fixed;\n  bottom: .75rem;\n  left: 50%;\n  transform: translateX(-50%);\n}\n\n.loading-wordmark {\n  width: min(92px, 28vw);\n}\n\n