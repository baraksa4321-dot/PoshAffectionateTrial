ading-food-three {\n  background: var(--sage);\n  width: 6px;\n  height: 6px;\n  animation-delay: .5s;\n  top: 35px;\n  right: 30px;\n}\n\n@keyframes loading-lift {\n  0%, 100% {\n    transform: translateY(5px) rotate(-3deg);\n  }\n\n  50% {\n    transform: translateY(-7px) rotate(3deg);\n  }\n}\n\n@keyframes loading-bounce {\n  0%, 100% {\n    transform: translateY(4px) rotate(-4deg);\n  }\n\n  50% {\n    transform: translateY(-7px) rotate(4deg);\n  }\n}\n\n@keyframes loading-bowl-fill {\n  0%, 100% {\n    height: 30%;\n  }\n\n  50% {\n    height: 70%;\n  }\n}\n\n@keyframes loading-stir {\n  0%, 100% {\n    transform: rotate(20deg);\n  }\n\n  50% {\n    transform: rotate(42deg);\n  }\n}\n\n@keyframes loading-food-pop {\n  0%, 100% {\n    opacity: .45;\n    transform: translateY(10px) scale(.8);\n  }\n\n  50% {\n    opacity: 1;\n    transform: translateY(-3px) scale(1);\n  }\n}\n\n.loading-cup {\n  border: 3px solid var(--primary);\n  background: var(--primary);\n  border-radius: 8px 8px 18px 18px;\n  width: 56px;\n  height: 55px;\n  position: absolute;\n  bottom: 7px;\n  right: 18px;\n  overflow: hidden;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-cup {\n    background: color-mix(in srgb, var(--primary) 7%, white);\n  }\n}\n\n.loading-cup {\n  transform: rotate(-4deg);\n}\n\n.loading-cup:before {\n  border: 3px solid var(--primary);\n  content: \"\";\n  background: #fff;\n  border-radius: 50%;\n  width: 60px;\n  height: 12px;\n  position: absolute;\n  top: -5px;\n  left: -5px;\n}\n\n.loading-cup-fill {\n  background: linear-gradient(180deg, var(--rose), var(--primary));\n  height: 16%;\n  animation: 1.8s ease-in-out infinite loading-fill;\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n}\n\n.loading-cup-handle {\n  border: 3px solid var(--primary);\n  border-left: 0;\n  border-radius: 0 14px 14px 0;\n  width: 22px;\n  height: 27px;\n  position: absolute;\n  bottom: 20px;\n  right: 4px;\n  transform: rotate(-4deg);\n}\n\n.loadin