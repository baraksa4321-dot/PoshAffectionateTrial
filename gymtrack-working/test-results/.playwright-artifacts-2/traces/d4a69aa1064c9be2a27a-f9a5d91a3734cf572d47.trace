{\n    box-shadow: 0 0 0 5px color-mix(in srgb, var(--primary) 13%, transparent);\n  }\n}\n\n.loading-live-dot {\n  animation: 1.5s ease-in-out infinite loading-pulse;\n}\n\n.loading-illustration-frame {\n  background: radial-gradient(circle at 50% 50%, var(--primary), transparent 56%), var(--cream);\n  border-radius: 26px;\n  place-items: center;\n  min-height: 128px;\n  margin-top: 7px;\n  display: grid;\n  position: relative;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-illustration-frame {\n    background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--primary) 11%, transparent), transparent 56%), color-mix(in srgb, var(--cream) 65%, var(--card));\n  }\n}\n\n.loading-mini-pill {\n  z-index: 3;\n  border: 1px solid var(--primary);\n  place-items: center;\n  width: 30px;\n  height: 30px;\n  display: grid;\n  position: absolute;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-mini-pill {\n    border: 1px solid color-mix(in srgb, var(--primary) 24%, transparent);\n  }\n}\n\n.loading-mini-pill {\n  background: var(--card);\n  border-radius: 11px;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-mini-pill {\n    background: color-mix(in srgb, var(--card) 92%, var(--primary));\n  }\n}\n\n.loading-mini-pill {\n  color: var(--primary);\n  font-size: 9px;\n  font-weight: 900;\n  animation: 2.6s ease-in-out infinite loading-float;\n  box-shadow: 0 8px 18px #462e351a;\n}\n\n.loading-mini-pill-one {\n  top: 22px;\n  right: 26%;\n}\n\n.loading-mini-pill-two {\n  animation-delay: -1.2s;\n  bottom: 20px;\n  left: 25%;\n}\n\n.loading-orbit {\n  border: 1px solid var(--primary);\n  position: absolute;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-orbit {\n    border: 1px solid color-mix(in srgb, var(--primary) 16%, transparent);\n  }\n}\n\n.loading-orbit {\n  pointer-events: none;\n  border-radius: 50%;\n  animation: 10s linear infinite loading-orbit;\n}\n\n.loading-orbit-one {\n  width: 120px;\n  height: 120px;\n  top: 3%;\n  right: 2%;\n}\n\n.loading-orbit-two {\n  width: 90px;\n  height: 90px;\n  animation-direction: reverse;\n  bottom: 2%;\n  left: -4%;\n}\n\n.loading-spark {\n  z-index: 2;\n  color: var(--primary);\n  text-shadow: 0 4px 15px var(--primary);\n  font-size: 22px;\n  font-weight: 900;\n  position: absolute;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-spark {\n    text-shadow: 0 4px 15px color-mix(in srgb, var(--primary) 35%, transparent);\n  }\n}\n\n.loading-spark {\n  animation: 2.2s ease-in-out infinite loading-sparkle;\n}\n\n.loading-spark-one {\n  top: 13%;\n  left: 13%;\n}\n\n.loading-spark-two {\n  animation-delay: -.7s;\n  top: 29%;\n  right: 7%;\n}\n\n.loading-spark-three {\n  font-size: 28px;\n  animation-delay: -1.4s;\n  bottom: 13%;\n  right: 14%;\n}\n\n.loading-witty-message {\n  z-index: 1;\n  min-height: 24px;\n  color: var(--foreground);\n  font-family: var(--font-display);\n  margin-top: 9px;\n  font-size: 15px;\n  font-weight: 800;\n  animation: .4s both loading-message-in;\n  position: relative;\n}\n\n.loading-status-line {\n  margin-top: 13px;\n  font-size: 10px;\n}\n\n.loading-status-dots {\n  gap: 4px;\n  display: inline-flex;\n}\n\n.loading-status-dots i {\n  background: var(--primary);\n  border-radius: 50%;\n  width: 4px;\n  height: 4px;\n  animation: 1.2s ease-in-out infinite loading-dot;\n  display: block;\n}\n\n.loading-status-dots i:nth-child(2) {\n  animation-delay: .16s;\n}\n\n.loading-status-dots i:nth-child(3) {\n  animation-delay: .32s;\n}\n\n.loading-progress {\n  z-index: 1;\n  background: var(--primary);\n  border-radius: 999px;\n  height: 6px;\n  margin-top: 9px;\n  position: relative;\n  overflow: hidden;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-progress {\n    background: color-mix(in srgb, var(--primary) 11%, var(--card));\n  }\n}\n\n.loading-progress span {\n  border-radius: inherit;\n  background: linear-gradient(90deg, var(--sage), var(--primary), var(--rose));\n  width: 38%;\n  height: 100%;\n  animation: 1.8s ease-in-out infinite loading-progress;\n  display: block;\n}\n\n.loading-card-footer {\n  color: var(--muted-foreground);\n  margin-top: 12px;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-card-footer {\n    color: color-mix(in srgb, var(--muted-foreground) 80%, var(--primary));\n  }\n}\n\n.loading-card-footer {\n  letter-spacing: .04em;\n  font-size: 9px;\n}\n\n@keyframes loading-card-in {\n  from {\n    opacity: 0;\n    transform: translateY(12px) scale(.97);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n@keyframes loading-spinner-rotate {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@keyframes loading-message-in {\n  from {\n    opacity: 0;\n    transform: translateY(5px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes loading-pulse {\n  0%, 100% {\n    opacity: .65;\n    transform: scale(.85);\n  }\n\n  50% {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n@keyframes loading-blink {\n  0%, 100% {\n    opacity: .35;\n  }\n\n  50% {\n    opacity: 1;\n  }\n}\n\n@keyframes loading-float {\n  0%, 100% {\n    transform: translateY(3px) rotate(-5deg);\n  }\n\n  50% {\n    transform: translateY(-7px) rotate(5deg);\n  }\n}\n\n@keyframes loading-orbit {\n  from {\n    transform: rotate(0) scale(1);\n  }\n\n  50% {\n    transform: rotate(180deg) scale(1.08);\n  }\n\n  to {\n    transform: rotate(360deg) scale(1);\n  }\n}\n\n@keyframes loading-sparkle {\n  0%, 100% {\n    opacity: .35;\n    transform: scale(.75) rotate(0);\n  }\n\n  50% {\n    opacity: 1;\n    transform: scale(1.08) rotate(18deg);\n  }\n}\n\n@keyframes loading-dot {\n  0%, 100% {\n    opacity: .35;\n    transform: translateY(0);\n  }\n\n  50% {\n    opacity: 1;\n    transform: translateY(-3px);\n  }\n}\n\n@keyframes loading-progress {\n  0% {\n    transform: translateX(230%);\n  }\n\n  100% {\n    transform: translateX(-290%);\n  