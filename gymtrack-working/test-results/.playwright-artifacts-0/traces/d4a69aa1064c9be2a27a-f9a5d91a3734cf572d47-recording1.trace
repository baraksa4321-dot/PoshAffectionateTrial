n.page-scroll-container, [data-overlay-panel=\"true\"] {\n  touch-action: pan-y;\n  -webkit-overflow-scrolling: touch;\n}\n\n.page-scroll-container {\n  overscroll-behavior-y: contain;\n  min-height: 0;\n  scroll-padding-top: calc(var(--app-topbar-height, 5rem) + 1rem);\n  flex: auto;\n  scroll-padding-bottom: 6.5rem;\n  overflow: hidden auto;\n}\n\nhtml[data-keyboard-open] .page-scroll-container, html[data-keyboard-open] [data-coach-workspace=\"true\"] {\n  overflow-anchor: none;\n}\n\n[data-coach-workspace=\"true\"] {\n  max-height: calc(100lvh - var(--app-topbar-height, 5rem) - .5rem);\n  min-height: 0;\n  padding-bottom: calc(6.5rem + env(safe-area-inset-bottom));\n  overscroll-behavior-y: contain;\n  -webkit-overflow-scrolling: touch;\n  touch-action: pan-y;\n  scroll-padding-bottom: calc(6.5rem + env(safe-area-inset-bottom));\n  overflow: hidden auto;\n}\n\ninput:not([type=\"hidden\"]):not([type=\"file\"]), textarea, select, [contenteditable=\"true\"] {\n  scroll-margin: 0;\n}\n\n.workout-progress-sticky {\n  z-index: 22;\n  box-shadow: 0 8px 24px rgb(var(--shadow-color) / 12%), 0 1px 0 var(--border);\n  margin-inline: -.15rem;\n  position: sticky;\n  top: 0;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .workout-progress-sticky {\n    box-shadow: 0 8px 24px rgb(var(--shadow-color) / 12%), 0 1px 0 color-mix(in srgb, var(--border) 75%, transparent);\n  }\n}\n\nhtml[data-keyboard-open] .workout-progress-sticky, html[data-keyboard-open] .nav-shell {\n  visibility: hidden;\n  pointer-events: none;\n}\n\n[data-overlay-panel=\"true\"] {\n  overscroll-behavior-y: contain;\n}\n\n::view-transition-old(root) {\n  animation-duration: .34s;\n  animation-timing-function: cubic-bezier(.22, .72, .18, 1);\n}\n\n::view-transition-new(root) {\n  animation-duration: .34s;\n  animation-timing-function: cubic-bezier(.22, .72, .18, 1);\n}\n\n::view-transition-old(root) {\n  transform-origin: center;\n  animation-name: route-slide-out;\n}\n\n::view-transition-new(root) {\n  transform-origin: center;\n  animation-name: route-slide-in;\n}\n\n@keyframes route-slide-out {\n  from {\n    opacity: 1;\n    transform: translate3d(0, 0, 0);\n  }\n\n  to {\n    opacity: .92;\n    transform: translate3d(-.7rem, 0, 0) scale(.995);\n  }\n}\n\n@keyframes route-slide-in {\n  from {\n    opacity: .92;\n    transform: translate3d(.7rem, 0, 0) scale(.995);\n  }\n\n  to {\n    opacity: 1;\n    transform: translate3d(0, 0, 0);\n  }\n}\n\n@keyframes page-enter-in {\n  from {\n    opacity: 0;\n    transform: translate3d(.7rem, 0, 0) scale(.995);\n  }\n\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n.tab-content-enter, .workspace-tab-content {\n  transform-origin: top;\n  animation: .22s cubic-bezier(.22, .8, .24, 1) both tab-content-in;\n}\n\n@keyframes tab-content-in {\n  from {\n    opacity: 0;\n    transform: translate3d(.55rem, 0, 0) scale(.997);\n  }\n\n  to {\n    opacity: 1;\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .page-enter, .tab-content-enter, .workspace-tab-content {\n    animation: none !important;\n  }\n\n  ::view-transition-old(root) {\n    animation-duration: 1ms !important;\n  }\n\n  ::view-transition-new(root) {\n    animation-duration: 1ms !important;\n  }\n}\n\n.fade-in {\n  animation: .25s both fade-in;\n}\n\n.scale-in {\n  animation: .2s both scale-in;\n}\n\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n\n.workout-surface-bookmark {\n  z-index: 2;\n  border: 1px solid var(--primary);\n  justify-content: center;\n  align-items: center;\n  display: flex;\n  position: absolute;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .workout-surface-bookmark {\n    border: 1px solid color-mix(in oklch, var(--primary) 35%, var(--border));\n  }\n}\n\n.workout-surface-bookmark {\n  background: var(--background);\n  color: var(--primary);\n  transition: background-color .18s, co