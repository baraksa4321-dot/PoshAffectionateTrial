{"version":8,"type":"context-options","origin":"library","browserName":"webkit","playwrightVersion":"1.62.1","options":{"noDefaultViewport":false,"viewport":{"width":390,"height":664},"ignoreHTTPSErrors":false,"javaScriptEnabled":true,"bypassCSP":false,"userAgent":"Mozilla/5.0 (iPhone; CPU iPhone OS 15_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/26.5 Mobile/15E148 Safari/604.1","locale":"he-IL","timezoneId":"Asia/Jerusalem","offline":false,"deviceScaleFactor":3,"isMobile":true,"hasTouch":true,"colorScheme":"light","acceptDownloads":"accept","baseURL":"http://127.0.0.1:4173","serviceWorkers":"allow","selectorEngines":[],"testIdAttributeName":"data-testid"},"platform":"linux","wallTime":1789085987421,"monotonicTime":3674.688,"sdkLanguage":"javascript","testIdAttributeName":"data-testid","contextId":"browser-context@f23fcde97509e360d1788ce66750fd44","title":"authenticated-ios.pw.mjs:784 › authenticated iPhone coach workspace and active workout remain usable"}
