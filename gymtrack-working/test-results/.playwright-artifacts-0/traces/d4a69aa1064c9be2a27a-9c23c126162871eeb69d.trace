ly: var(--font-display);\n  margin-top: 8px;\n  font-size: 11px;\n  font-weight: 800;\n  animation: .3s both loading-message-in;\n}\n\n.loading-clean-dots {\n  justify-content: center;\n  gap: 4px;\n  margin-top: 10px;\n  display: flex;\n}\n\n.loading-clean-dots span {\n  background: var(--primary);\n  opacity: .35;\n  border-radius: 50%;\n  width: 4px;\n  height: 4px;\n  animation: 1.1s ease-in-out infinite loading-dot;\n}\n\n.loading-clean-dots span:nth-child(2) {\n  animation-delay: .15s;\n}\n\n.loading-clean-dots span:nth-child(3) {\n  animation-delay: .3s;\n}\n\n@keyframes loading-micro-ring {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n@keyframes loading-micro-float {\n  0%, 100% {\n    transform: translateY(3px) rotate(-4deg);\n  }\n\n  50% {\n    transform: translateY(-5px) rotate(4deg);\n  }\n}\n\n@keyframes loading-micro-breathe {\n  0%, 100% {\n    opacity: .65;\n    transform: scale(.86);\n  }\n\n  50% {\n    opacity: 1;\n    transform: scale(1.08);\n  }\n}\n\n@keyframes loading-micro-wiggle {\n  0%, 100% {\n    transform: rotate(-8deg);\n  }\n\n  25% {\n    transform: rotate(8deg) translateY(-2px);\n  }\n\n  75% {\n    transform: rotate(5deg) translateY(2px);\n  }\n}\n\n@keyframes loading-micro-orbit {\n  0%, 100% {\n    transform: translate(0);\n  }\n\n  25% {\n    transform: translate(4px, -3px);\n  }\n\n  50% {\n    transform: translate(0, -5px);\n  }\n\n  75% {\n    transform: translate(-4px, -2px);\n  }\n}\n\n@keyframes loading-micro-pop {\n  0%, 100% {\n    transform: scale(.75) translateY(3px);\n  }\n\n  45% {\n    transform: scale(1.08) translateY(-3px);\n  }\n\n  65% {\n    transform: scale(.96) translateY(0);\n  }\n}\n\n@keyframes loading-micro-sway {\n  0%, 100% {\n    transform: translateX(-3px) rotate(-5deg);\n  }\n\n  50% {\n    transform: translateX(3px) rotate(5deg);\n  }\n}\n\n@keyframes loading-micro-twirl {\n  0%, 100% {\n    transform: rotate(-10deg) scale(.94);\n  }\n\n  50% {\n    transform: rotate(10deg) scale(1.05);\n  }\n