\"ios-smoke-item-8\",\"exerciseId\":\"ios-smoke-exercise-8\",\"exerciseName\":\"תרגיל בדיקה 8\",\"sets\":3,\"reps\":11,\"repType\":\"fixed\",\"weight\":27,\"rest\":60,\"notes\":\"הערת מאמן לתרגיל האחרון\"}]},{\"id\":\"ios-smoke-workout-2\",\"name\":\"אימון בדיקה 2\",\"notes\":\"יום בדיקה 2\",\"items\":[]},{\"id\":\"ios-smoke-workout-3\",\"name\":\"אימון בדיקה 3\",\"notes\":\"יום בדיקה 3\",\"items\":[]},{\"id\":\"ios-smoke-workout-4\",\"name\":\"אימון בדיקה 4\",\"notes\":\"יום בדיקה 4\",\"items\":[]}],\"programs\":[{\"id\":\"ios-smoke-program\",\"name\":\"תוכנית בדיקה לאייפון\",\"notes\":\"בדיקת סביבת עבודה ארוכה\",\"dayIds\":[\"ios-smoke-workout\",\"ios-smoke-workout-2\",\"ios-smoke-workout-3\",\"ios-smoke-workout-4\"]}],\"history\":[],\"foods\":[],\"nutritionDays\":[],\"nutritionTargets\":{},\"plannedMeals\":[{\"id\":\"ios-smoke-meal\",\"name\":\"ארוחת בדיקה\",\"foods\":[{\"id\":\"ios-smoke-meal-food\",\"foodId\":\"f-rice\",\"name\":\"אורז\",\"servingSize\":\"1 מנה\",\"quantity\":1,\"calories\":200,\"protein\":4,\"carbs\":44,\"fat\":0}]}],\"mealTemplate\":[],\"recipes\":[],\"recentFoods\":[],\"favoriteFoods\":[],\"bodyWeightLogs\":[],\"bodyMeasurements\":[],\"cardioLogs\":[],\"preExitChecklist\":[],\"userProfile\":{\"fullName\":\"מאמנת בדיקה\",\"weight\":62,\"height\":168,\"age\":31,\"gender\":\"female\",\"role\":\"coach\",\"approvalStatus\":\"approved\",\"showCalories\":true,\"theme\":\"pink\"}},\"session\":{\"access_token\":\"ios-smoke-access-token\",\"refresh_token\":\"ios-smoke-refresh-token\",\"expires_in\":3600,\"expires_at\":1788875921,\"token_type\":\"bearer\",\"user\":{\"id\":\"ios-smoke-coach\",\"aud\":\"authenticated\",\"role\":\"authenticated\",\"email\":\"ios-smoke-coach@example.test\",\"app_metadata\":{\"provider\":\"email\",\"providers\":[\"email\"]},\"user_metadata\":{\"full_name\":\"מאמנת בדיקה\",\"gender\":\"female\"},\"created_at\":\"2026-01-01T00:00:00.000Z\",\"confirmed_at\":\"2026-01-01T00:00:00.000Z\"}},\"clientProfile\":{\"id\":\"ios-smoke-c