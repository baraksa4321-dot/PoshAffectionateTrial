0) scale(.997);\n  }\n\n  to {\n    opacity: 1;\n    transform: translate3d(0, 0, 0) scale(1);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .page-enter, .tab-content-enter, .workspace-tab-content {\n    animation: none !important;\n  }\n\n  ::view-transition-old(root) {\n    animation-duration: 1ms !important;\n  }\n\n  ::view-transition-new(root) {\n    animation-duration: 1ms !important;\n  }\n}\n\n.fade-in {\n  animation: .25s both fade-in;\n}\n\n.scale-in {\n  animation: .2s both scale-in;\n}\n\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n\n.workout-surface-bookmark {\n  z-index: 2;\n  border: 1px solid var(--primary);\n  justify-content: center;\n  align-items: center;\n  display: flex;\n  position: absolute;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .workout-surface-bookmark {\n    border: 1px solid color-mix(in oklch, var(--primary) 35%, var(--border));\n  }\n}\n\n.workout-surface-bookmark {\n  background: var(--background);\n  color: var(--primary);\n  transition: background-color .18s, color .18s, transform .18s;\n  box-shadow: 0 8px 24px oklch(20% .03 35 / .12);\n}\n\n.workout-surface-bookmark:hover, .workout-surface-bookmark:focus-visible, .workout-report-bookmark-open {\n  background: var(--primary);\n  color: var(--primary-foreground);\n}\n\n.workout-surface-bookmark:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.workout-report-bookmark {\n  border-left: 0;\n  border-radius: .75rem 0 0 .75rem;\n  width: 1.75rem;\n  min-height: 5.25rem;\n  position: absolute;\n  top: 1rem;\n  right: 0;\n  transform: none;\n}\n\n.workout-report-bookmark:hover, .workout-report-bookmark:focus-visible {\n  transform: translateY(-1px);\n}\n\n.workout-report-bookmark-open {\n  border-left: 0;\n  border-right: 0;\n  left: 0;\n  right: auto;\n}\n\n.workout-report-bookmark-open:hover, .workout-report-bookmark-open:focus-visible {\