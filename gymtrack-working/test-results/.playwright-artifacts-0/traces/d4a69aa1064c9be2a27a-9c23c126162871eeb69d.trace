-illustration .loading-dumbbell-cap, .loading-simple-illustration .loading-dumbbell-grip {\n  stroke: var(--ink);\n  stroke-width: 1.6px;\n}\n\n@keyframes loading-bottom-fill {\n  0%, 12% {\n    opacity: .12;\n    transform: scaleY(0);\n  }\n\n  72%, 100% {\n    opacity: .86;\n    transform: scaleY(1);\n  }\n}\n\n.loading-growth-motion {\n  animation-duration: 2.1s;\n}\n\n.loading-growth-fill {\n  animation-name: loading-growth-fill;\n  animation-duration: 2.8s;\n}\n\n.loading-dumbbell-shadow {\n  fill: var(--ink);\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-dumbbell-shadow {\n    fill: color-mix(in srgb, var(--ink) 14%, transparent);\n  }\n}\n\n.loading-dumbbell-shadow {\n  transform-box: fill-box;\n  transform-origin: center;\n  animation: 1.8s ease-in-out infinite loading-dumbbell-shadow;\n}\n\n.loading-dumbbell-bar {\n  fill: var(--ink);\n}\n\n.loading-dumbbell-grip {\n  fill: url(\"#loading-metal\");\n  opacity: .94;\n}\n\n.loading-dumbbell-plate {\n  fill: var(--surface);\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-dumbbell-plate {\n    fill: color-mix(in srgb, var(--surface) 86%, var(--primary));\n  }\n}\n\n.loading-dumbbell-plate {\n  stroke: var(--primary);\n  stroke-width: 2px;\n}\n\n.loading-dumbbell-fill {\n  fill: url(\"#loading-metal\");\n  stroke: none;\n  transform-box: fill-box;\n  transform-origin: bottom;\n  animation: 2.5s ease-in-out infinite loading-dumbbell-fill;\n}\n\n.loading-dumbbell-highlight {\n  fill: none;\n  stroke: #fff;\n}\n\n@supports (color: color-mix(in lab, red, red)) {\n  .loading-dumbbell-highlight {\n    stroke: color-mix(in srgb, white 55%, var(--primary));\n  }\n}\n\n.loading-dumbbell-highlight {\n  stroke-linecap: round;\n  stroke-width: 2px;\n  opacity: .55;\n}\n\n.loading-dumbbell-cap {\n  fill: url(\"#loading-metal\");\n  stroke: var(--primary);\n  stroke-width: 2px;\n}\n\n.loading-micro-dot, .loading-clean-dots {\n  display: none;\n}\n\n.loading-micro-float {\n  animation: 1