ction: none;\n  overscroll-behavior: none !important;\n  overflow: hidden !important;\n}\n\n.illustrated-mark {\n  filter: drop-shadow(1px 2px #5c363e1a);\n  border: 1.5px solid;\n  border-radius: 46% 54% 51% 49%;\n  position: relative;\n  transform: rotate(-3deg);\n}\n\n.illustrated-mark:before, .illustrated-mark:after {\n  content: \"\";\n  pointer-events: none;\n  opacity: .45;\n  border: 1px solid;\n  border-radius: 999px;\n  position: absolute;\n}\n\n.illustrated-mark:before {\n  inset: -4px 2px 2px -3px;\n  transform: rotate(7deg);\n}\n\n.illustrated-mark:after {\n  background: currentColor;\n  border: 0;\n  width: 4px;\n  height: 4px;\n  top: -5px;\n  right: 4px;\n}\n\n:root.night-mode, :root.night-mode[data-theme] {\n  --background: #303035;\n  --foreground: #ecebed;\n  --surface: #3a3a40;\n  --surface-2: #44444b;\n  --cream: #303035;\n  --card: #3a3a40;\n  --card-foreground: #ecebed;\n  --popover: #3a3a40;\n  --popover-foreground: #ecebed;\n  --ink: #ecebed;\n  --ink-soft: #d0cdd2;\n  --muted: #35353b;\n  --muted-foreground: #c0bcc3;\n  --secondary: #34343a;\n  --secondary-foreground: #ecebed;\n  --accent-foreground: #ecebed;\n  --border: #51515a;\n  --input: #55555f;\n  --ring: var(--primary);\n  --shadow-color: 0 0 0;\n}\n\nhtml.night-mode, html.night-mode body, html.night-mode #root {\n  color: var(--foreground);\n  background-color: var(--background) !important;\n  background-image: none !important;\n}\n\nhtml.night-mode .bg-white, html.night-mode .bg-white\\/60, html.night-mode .bg-white\\/70, html.night-mode .bg-white\\/80 {\n  background-color: var(--surface) !important;\n  color: var(--ink) !important;\n}\n\nhtml.night-mode .bg-background {\n  background-color: var(--background) !important;\n}\n\nhtml.night-mode .nutrition-balance-card {\n  box-shadow: inset 0 1px #ffffff12, 0 8px 22px #0000002e;\n  background: var(--surface-2) !important;\n  border-color: var(--border) !important;\n}\n\n.app-topbar {\n  isolation: isolate;\n  transform: translateZ(