ading-bubble {\n  background: var(--primary);\n  opacity: 0;\n  border-radius: 999px;\n  width: 7px;\n  height: 7px;\n  animation: 1.8s ease-in infinite loading-bubble;\n  position: absolute;\n  bottom: 48px;\n}\n\n.loading-bubble-one {\n  right: 42px;\n}\n\n.loading-bubble-two {\n  width: 5px;\n  height: 5px;\n  animation-delay: .55s;\n  right: 29px;\n}\n\n.loading-bubble-three {\n  width: 4px;\n  height: 4px;\n  animation-delay: 1s;\n  right: 52px;\n}\n\n@keyframes loading-fill {\n  0%, 100% {\n    height: 16%;\n  }\n\n  50% {\n    height: 72%;\n  }\n}\n\n@keyframes loading-bubble {\n  0% {\n    opacity: 0;\n    transform: translateY(10px) scale(.7);\n  }\n\n  35%, 70% {\n    opacity: .7;\n  }\n\n  100% {\n    opacity: 0;\n    transform: translateY(-24px) scale(1);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage, .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage *, .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage:before, .loading-screen[data-loading-mode=\"expressive\"] .loading-micro-stage:after {\n    animation-duration: 1.8s !important;\n    animation-iteration-count: infinite !important;\n  }\n}\n\n.loading-screen {\n  z-index: 1000;\n  box-sizing: border-box;\n  overscroll-behavior: none;\n  touch-action: none;\n  width: 100%;\n  height: 100lvh;\n  min-height: 100lvh;\n  max-height: 100lvh;\n  padding-top: env(safe-area-inset-top);\n  padding-bottom: env(safe-area-inset-bottom);\n  color: #171414;\n  position: fixed;\n  inset: 0;\n  overflow: hidden;\n  background: #f7f1ec !important;\n}\n\n.loading-screen:before, .loading-screen:after, .loading-stage, .loading-orbit, .loading-spark {\n  display: none;\n}\n\n.loading-brand {\n  text-align: center;\n  background: none;\n  width: min(100%, 240px);\n  padding: 14px 0 10px;\n}\n\n.loading-wordmark, .loading-initial-wordmark {\n  z-index: 2;\n  object-fit: contain;\n  height: auto;\n  margin: 0