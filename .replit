modules = ["web", "python-base-3.13", "nodejs-22"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "gymtrack-typecheck"

[[workflows.workflow]]
name = "gymtrack-typecheck"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm run release:check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
VITE_SUPABASE_URL = "https://pnvtxazqtorylcsjtatv.supabase.co/rest/v1/"
VITE_SUPABASE_ANON_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBudnR4YXpxdG9yeWxjc2p0YXR2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcyNTk4MjYsImV4cCI6MjEwMjgzNTgyNn0.L6ZSPRfeJ2EeXw1g7ElIUXHkffF2pjS-4U6qF4EFLAo"
GYMTRACK_SMOKE_ALLOW_LIVE = "true"

[nix]
channel = "stable-25_05"
packages = ["gtk4", "glib", "pango", "harfbuzz", "gdk-pixbuf", "cairo", "vulkan-loader", "graphene", "icu", "libxml2", "sqlite", "libxslt", "lcms2", "libevent", "flite", "libwebp", "libavif", "libepoxy", "libjpeg", "libsecret", "wayland", "libmanette", "enchant", "libgbm", "libdrm", "atk", "at-spi2-atk", "libxkbcommon", "x264", "libopus", "libglvnd", "icu74", "gst_all_1.gstreamer", "gst_all_1.gst-plugins-base", "gst_all_1.gst-plugins-good", "gst_all_1.gst-plugins-bad", "gst_all_1.gst-plugins-ugly", "gst_all_1.gst-libav", "hyphen", "gcc", "libbacktrace", "libjxl", "libsoup_3", "harfbuzzFull", "libjpeg8", "libjpeg_turbo", "mesa", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "xorg.libxkbfile", "xorg.libxshmfence", "xorg.libXi", "xorg.libXrender", "xorg.libXtst"]
